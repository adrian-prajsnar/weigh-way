---
import BaseLayout from '../../layouts/base-layout.astro';
import SiteHeader from '../../components/site-header.astro';
import SiteFooter from '../../components/site-footer.astro';
import HomePage from '../../components/home-page.astro';
import { getMessages } from '../../i18n';

const locale = 'pl' as const;
const t = getMessages(locale);
---

<BaseLayout locale={locale} page="home" title={t.meta.title} description={t.meta.description}>
  <SiteHeader locale={locale} page="home" />
  <main id="content" tabindex="-1">
    <HomePage locale={locale} />
  </main>
  <SiteFooter locale={locale} />
</BaseLayout>
