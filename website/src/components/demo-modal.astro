---
import { getMessages, type SiteLocale } from '../i18n';
import { withBase } from '../lib/paths';

type Props = { locale: SiteLocale };
const { locale } = Astro.props;
const t = getMessages(locale);
const demoUrl = withBase(`/demo/?embed=1&lang=${locale}`);
---

<div class="demo-modal" data-demo-modal data-demo-url={demoUrl} hidden>
  <button class="demo-modal__backdrop" type="button" data-demo-close aria-label={t.demoModal.close}></button>
  <button class="demo-modal__close" type="button" data-demo-close aria-label={t.demoModal.close}>
    <svg
      width="24"
      height="24"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M18 6 6 18"></path>
      <path d="m6 6 12 12"></path>
    </svg>
  </button>
  <div
    class="demo-modal__dialog"
    role="dialog"
    aria-modal="true"
    aria-label={t.demoModal.title}
    tabindex="-1"
    data-demo-dialog
  >
    <div class="app-screen-frame demo-modal__phone">
      <span class="phone-island" aria-hidden="true"></span>
      <div class="demo-modal__screen">
        <div class="phone-status-bar" aria-hidden="true">
          <span class="phone-status-bar__time" data-demo-status-time>9:41</span>
          <span class="phone-status-bar__icons">
            <svg class="phone-status-bar__signal" viewBox="0 0 18 12" fill="currentColor" aria-hidden="true">
              <rect x="0" y="8" width="3" height="4" rx="0.75"></rect>
              <rect x="5" y="5.5" width="3" height="6.5" rx="0.75"></rect>
              <rect x="10" y="3" width="3" height="9" rx="0.75"></rect>
              <rect x="15" y="0" width="3" height="12" rx="0.75"></rect>
            </svg>
            <svg class="phone-status-bar__wifi" viewBox="0 0 20 14" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M1.5 5.2a14 14 0 0 1 17 0"></path>
              <path d="M4.8 8.4a9.5 9.5 0 0 1 10.4 0"></path>
              <path d="M8.2 11.6a4.5 4.5 0 0 1 3.6 0"></path>
              <circle cx="10" cy="13" r="1.1" fill="currentColor" stroke="none"></circle>
            </svg>
            <svg class="phone-status-bar__bluetooth" viewBox="0 0 12 18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M6 1v16"></path>
              <path d="m2.5 4.5 7.5 4.5-7.5 4.5"></path>
            </svg>
            <svg class="phone-status-bar__battery" viewBox="0 0 26 12" fill="none" aria-hidden="true">
              <rect x="0.75" y="0.75" width="21" height="10.5" rx="2.5" stroke="currentColor" stroke-width="1.4"></rect>
              <path d="M23.25 4.25v4.5a1.5 1.5 0 0 0 0-4.5z" fill="currentColor" opacity="0.45"></path>
              <rect x="2.75" y="2.75" width="15" height="6.5" rx="1.25" fill="currentColor"></rect>
            </svg>
          </span>
        </div>
        <div
          class="demo-modal__skeleton"
          data-demo-skeleton
          aria-hidden="true"
          aria-label={t.demoModal.loading}
        >
          <div class="demo-skeleton__header">
            <span class="demo-skeleton__line demo-skeleton__line--screen-title"></span>
            <span class="demo-skeleton__line demo-skeleton__line--screen-subtitle"></span>
          </div>
          <div class="demo-skeleton__card demo-skeleton__card--hero">
            <span class="demo-skeleton__line demo-skeleton__line--hero-label"></span>
            <span class="demo-skeleton__line demo-skeleton__line--hero-value"></span>
            <span class="demo-skeleton__line demo-skeleton__line--hero-meta"></span>
            <span class="demo-skeleton__line demo-skeleton__line--hero-range"></span>
            <span class="demo-skeleton__line demo-skeleton__line--hero-chart"></span>
          </div>
          <div class="demo-skeleton__card demo-skeleton__card--entry">
            <span class="demo-skeleton__line demo-skeleton__line--card-title"></span>
            <span class="demo-skeleton__line demo-skeleton__line--entry-row"></span>
            <span class="demo-skeleton__line demo-skeleton__line--entry-row demo-skeleton__line--entry-row-tall"></span>
          </div>
          <div class="demo-skeleton__tabbar" aria-hidden="true">
            <div class="demo-skeleton__tabbar-pill">
              <span class="demo-skeleton__tab-slot demo-skeleton__tab-slot--active"></span>
              <span class="demo-skeleton__tab-slot"></span>
              <span class="demo-skeleton__tab-slot"></span>
              <span class="demo-skeleton__tab-slot"></span>
            </div>
          </div>
        </div>
        <iframe
          data-demo-iframe
          class="demo-modal__iframe"
          title={t.demoModal.title}
          loading="lazy"
          allow="clipboard-read; clipboard-write"
        ></iframe>
      </div>
      <span class="phone-home" aria-hidden="true"></span>
    </div>
  </div>
</div>

<script>
  import { initDemoModal } from '../scripts/demo-modal';

  initDemoModal();
</script>
