---
import { getMessages, localePath, type SiteLocale, type SitePage } from '../i18n';
import { withBase } from '../lib/paths';
import BrandLogo from './brand-logo.astro';

type Props = {
  locale: SiteLocale;
  page: SitePage;
};

const { locale, page } = Astro.props;
const t = getMessages(locale);

const links = [
  { page: 'home' as const, href: withBase(localePath(locale, 'home')), label: t.nav.home },
  { page: 'releases' as const, href: withBase(localePath(locale, 'releases')), label: t.nav.releases },
];
---

<header
  class="site-header"
  data-page-locale={locale}
  data-base-url={import.meta.env.BASE_URL}
>
  <div class="header-bar">
    <div class="header-shell">
      <div class="header-inner">
        <a class="brand" href={withBase(localePath(locale, page))}>
          <BrandLogo size={36} />
          <span class="brand-name">{t.brand}</span>
        </a>
        <button
          type="button"
          class="menu-toggle"
          data-menu-toggle
          data-label-open={t.nav.menu}
          data-label-close={t.nav.close}
          aria-expanded="false"
          aria-controls="site-menu"
          aria-label={t.nav.menu}
        >
          <span class="menu-toggle-icon" aria-hidden="true">
            <span></span>
            <span></span>
            <span></span>
          </span>
        </button>
      </div>
      <div class="header-menu" id="site-menu">
        <nav class="header-nav" aria-label={t.brand}>
          {
            links.map((link) => (
              <a
                class="nav-link"
                href={link.href}
                aria-current={link.page === page ? 'page' : undefined}
              >
                {link.label}
              </a>
            ))
          }
        </nav>
        <div class="header-controls">
          <div class="icon-toggle icon-toggle--icons" role="group" aria-label={t.language.label} data-language-toggle>
            <button type="button" data-language="system" aria-label={t.language.system} aria-pressed="false">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="12" cy="12" r="10"></circle>
                <path d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
              </svg>
            </button>
            <button type="button" data-language="en" aria-label={t.language.english} aria-pressed="false">ENG</button>
            <button type="button" data-language="pl" aria-label={t.language.polish} aria-pressed="false">PL</button>
          </div>
          <div class="icon-toggle icon-toggle--icons" role="group" aria-label={t.theme.label} data-theme-toggle>
            <button type="button" data-theme="system" aria-label={t.theme.system} aria-pressed="false">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="2" y="3" width="20" height="14" rx="2"></rect>
                <path d="M8 21h8M12 17v4"></path>
              </svg>
            </button>
            <button type="button" data-theme="light" aria-label={t.theme.light} aria-pressed="false">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                <circle cx="12" cy="12" r="4"></circle>
                <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path>
              </svg>
            </button>
            <button type="button" data-theme="dark" aria-label={t.theme.dark} aria-pressed="false">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                <path d="M21 14.5A8.5 8.5 0 0 1 9.5 3 7 7 0 1 0 21 14.5z"></path>
              </svg>
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
  <div class="menu-overlay" data-menu-overlay aria-hidden="true"></div>
</header>

<div class="theme-splash" data-theme-splash aria-hidden="true">
  <div class="theme-splash-inner">
    <div class="theme-splash-logo">
      <BrandLogo size={72} />
    </div>
    <p class="theme-splash-name">{t.brand}</p>
    <p class="theme-splash-tagline">{t.footer.tagline}</p>
  </div>
</div>

<script>
  import { initSiteHeader } from '../scripts/site-header';

  initSiteHeader();
</script>
