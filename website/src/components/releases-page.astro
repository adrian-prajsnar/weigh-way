---
import PlatformDownloads from './platform-downloads.astro';
import { marked } from 'marked';
import { dateLocale, getMessages, type SiteLocale } from '../i18n';
import { getReleases, notesFor } from '../lib/releases';

type Props = { locale: SiteLocale };
const { locale } = Astro.props;
const t = getMessages(locale);
const releases = getReleases();
const dateFmt = new Intl.DateTimeFormat(dateLocale(locale), {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

function formatDate(value: string) {
  if (!value) return '';
  const date = new Date(`${value}T00:00:00Z`);
  return Number.isNaN(date.getTime()) ? value : dateFmt.format(date);
}
---

<section class="page-hero">
  <div class="section-inner is-visible" data-reveal>
    <h1>{t.releases.title}</h1>
    <p class="section-lead">{t.releases.subtitle}</p>
  </div>
</section>

<section class="section">
  <div class="section-inner">
    {
      releases.length === 0 ? (
        <p class="card" data-reveal>{t.releases.empty}</p>
      ) : (
        <div class="release-list">
          {releases.map((release, index) => {
            const isLatest = index === 0;
            const html = marked.parse(notesFor(release, locale), { async: false }) as string;
            return (
              <article
                class:list={['release-card', isLatest && 'is-latest']}
                data-reveal
                style={`--reveal-delay: ${index * 80}ms`}
              >
                <div class="release-head">
                  <div>
                    <h2 class="release-version">
                      {release.version}
                      {isLatest && <span class="latest-badge">{t.releases.latest}</span>}
                    </h2>
                    <p class="release-date">{formatDate(release.date)}</p>
                  </div>
                  {isLatest ? (
                    <PlatformDownloads
                      apkUrl={release.apkUrl}
                      ipaUrl={release.ipaUrl}
                      downloadAndroid={t.releases.downloadAndroid}
                      downloadIos={t.releases.downloadIos}
                      unavailableAndroid={t.releases.noAndroidBuild}
                      unavailableIos={t.releases.noIosBuild}
                    />
                  ) : null}
                </div>
                <div class="release-notes" set:html={html} />
              </article>
            );
          })}
        </div>
      )
    }
  </div>
</section>
