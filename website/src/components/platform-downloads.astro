---
type Props = {
  apkUrl: string | null;
  ipaUrl: string | null;
  downloadAndroid: string;
  downloadIos: string;
  unavailableAndroid: string;
  unavailableIos: string;
};

const { apkUrl, ipaUrl, downloadAndroid, downloadIos, unavailableAndroid, unavailableIos } =
  Astro.props;
---

<div class="download-actions">
  {
    apkUrl ? (
      <a class="btn btn-primary" href={apkUrl}>
        <svg
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M12 4v12M7 11l5 5 5-5M5 20h14"></path>
        </svg>
        <span>{downloadAndroid}</span>
      </a>
    ) : (
      <span class="btn btn-primary is-disabled" aria-disabled="true">
        <span>{unavailableAndroid}</span>
      </span>
    )
  }
  {
    ipaUrl ? (
      <a class="btn btn-primary" href={ipaUrl}>
        <svg
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M12 4v12M7 11l5 5 5-5M5 20h14"></path>
        </svg>
        <span>{downloadIos}</span>
      </a>
    ) : (
      <span class="btn btn-primary is-disabled" aria-disabled="true">
        <span>{unavailableIos}</span>
      </span>
    )
  }
</div>
