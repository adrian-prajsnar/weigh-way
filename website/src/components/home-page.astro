---
import DemoButton from './demo-button.astro';
import PlatformDownloads from './platform-downloads.astro';
import { getMessages, type SiteLocale } from '../i18n';
import { getLatestRelease } from '../lib/releases';
import { absoluteUrl } from '../lib/paths';

type Props = { locale: SiteLocale };
const { locale } = Astro.props;
const t = getMessages(locale);
const latest = getLatestRelease();
const apkUrl = latest?.apkUrl ?? null;
const ipaUrl = latest?.ipaUrl ?? null;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: t.brand,
  operatingSystem: 'Android, iOS',
  applicationCategory: 'HealthApplication',
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
  },
  description: t.meta.description,
  softwareVersion: latest?.version,
  url: absoluteUrl(locale === 'pl' ? '/pl/' : '/'),
};

const headlineLines = t.home.headline.split('\n');
const ctaPlayLetter = t.home.ctaTitlePlayLetter;
const ctaPlayIndex = ctaPlayLetter ? t.home.ctaTitle.indexOf(ctaPlayLetter) : -1;
const ctaWordStart = ctaPlayIndex >= 0 ? t.home.ctaTitle.lastIndexOf(' ', ctaPlayIndex) + 1 : -1;
const ctaWordEnd =
  ctaPlayIndex >= 0 && ctaPlayLetter
    ? ctaPlayIndex +
      ctaPlayLetter.length +
      (t.home.ctaTitle.slice(ctaPlayIndex + ctaPlayLetter.length).match(/^[^\s?!.]*/)?.[0].length ?? 0)
    : -1;
const featureIcons = [
  '<path d="M4 16l4-4 3 3 9-9"/><path d="M14 6h5v5"/>',
  '<path d="M5 19V9M10 19V5M15 19v-7M20 19V8"/>',
  '<circle cx="12" cy="8" r="3"/><path d="M5 19c1.2-3.4 3.8-5 7-5s5.8 1.6 7 5"/>',
  '<path d="M5 8h8M5 12h14M5 16h10"/>',
];
const highlightIcons = [
  '<rect x="4" y="5" width="16" height="15" rx="3"/><path d="M8 3v4M16 3v4M4 10h16"/>',
  '<circle cx="12" cy="12" r="8"/><path d="M12 8v4l2.5 1.5"/>',
  '<path d="M6 16a6 6 0 0 1 12 0"/><path d="M12 4v6M9 7h6"/>',
];
const floatCards = [
  { value: t.home.preview.latestValue, label: t.home.preview.latest, tone: 'a' },
  { value: t.home.preview.bmiValue, label: t.home.preview.bmi, tone: 'b' },
  { value: t.home.preview.thisWeekValue, label: t.home.preview.thisWeek, tone: 'c' },
];
const homeScreen = t.home.screens.find((screen) => screen.id === 'home');
---

<section class="hero" data-hero-slider>
  <div class="section-inner hero-grid">
    <div class="hero-slider-viewport">
      <div class="hero-slider-track">
        <div class="hero-copy hero-slider-slide is-visible" data-reveal>
      <p class="eyebrow">{t.home.eyebrow}</p>
      <h1>
        {
          headlineLines.map((line, index) => (
            <>
              {index === headlineLines.length - 1 ? <span class="headline-accent">{line}</span> : line}
              {index < headlineLines.length - 1 && <br />}
            </>
          ))
        }
      </h1>
      <p class="hero-sub">{t.home.subhead}</p>
      <div class="chip-row">
        <span class="chip">{t.home.freeBadge}</span>
        <span class="chip">{t.home.platformsBadge}</span>
        <span class="chip">{t.home.privateBadge}</span>
      </div>
      <div class="hero-actions">
        <PlatformDownloads
          apkUrl={apkUrl}
          ipaUrl={ipaUrl}
          downloadAndroid={t.home.downloadAndroid}
          downloadIos={t.home.downloadIos}
          unavailableAndroid={t.home.downloadUnavailableAndroid}
          unavailableIos={t.home.downloadUnavailableIos}
        />
        <DemoButton label={t.home.openDemo} />
        {
          latest && (
            <span class="version-chip version-chip--live">
              {t.home.versionLabel} {latest.version}
            </span>
          )
        }
      </div>
        </div>
        <div class="hero-visual hero-slider-slide is-visible" data-reveal style="--reveal-delay: 120ms">
      <div class="hero-tilt" data-hero-tilt>
        <div class="app-screen-frame app-screen-frame--hero">
          <span class="phone-island" aria-hidden="true"></span>
          <img
            class="app-screen-shot screen-shot-image"
            data-screenshot="home"
            alt={homeScreen?.title ?? 'Home'}
            loading="eager"
            decoding="async"
            width="360"
            height="660"
          />
          <span class="phone-home" aria-hidden="true"></span>
        </div>
      </div>
      {
        floatCards.map((card) => (
          <aside class={`float-card float-card--${card.tone}`} aria-hidden="true">
            <p class="float-card-value">{card.value}</p>
            <p class="float-card-label">{card.label}</p>
          </aside>
        ))
      }
        </div>
      </div>
    </div>
  </div>
  <div class="hero-slider-controls">
    <button
      type="button"
      class="hero-slider-arrow hero-slider-arrow--prev"
      data-hero-slider-prev
      aria-label={t.home.heroSliderPrev}
      hidden
    >
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M15 18l-6-6 6-6"></path>
          </svg>
        </button>
        <button
          type="button"
          class="hero-slider-arrow hero-slider-arrow--next"
          data-hero-slider-next
          aria-label={t.home.heroSliderNext}
        >
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M9 18l6-6-6-6"></path>
          </svg>
    </button>
  </div>
</section>

<section class="section section-alt">
  <div class="section-inner">
    <div class="section-heading" data-reveal>
      <h2>{t.home.highlightsTitle}</h2>
    </div>
    <div class="highlight-grid">
      {
        t.home.highlights.map((item, index) => (
          <article class="card" data-reveal style={`--reveal-delay: ${index * 80}ms`}>
            <div class="card-icon" aria-hidden="true">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <Fragment set:html={highlightIcons[index]} />
              </svg>
            </div>
            <h3>{item.title}</h3>
            <p>{item.body}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<section class="section">
  <div class="section-inner">
    <div class="section-heading" data-reveal>
      <h2>{t.home.featuresTitle}</h2>
      <p class="section-lead">{t.home.featuresSubtitle}</p>
    </div>
    <div class="feature-grid">
      {
        t.home.features.map((feature, index) => (
          <article class="card" data-reveal style={`--reveal-delay: ${(index % 2) * 80}ms`}>
            <div class="card-icon" aria-hidden="true">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <Fragment set:html={featureIcons[index]} />
              </svg>
            </div>
            <h3>{feature.title}</h3>
            <p>{feature.body}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<section class="section">
  <div class="section-inner">
    <div class="section-heading section-heading--screens" data-reveal>
      <h2>{t.home.screensTitle}</h2>
      <p class="section-lead">{t.home.screensSubtitle}</p>
    </div>
    <div class="screens-grid">
      {
        t.home.screens.map((screen, index) => (
          <figure class="screen-card" data-reveal style={`--reveal-delay: ${index * 70}ms`}>
            <h3 class="screen-title">{screen.title}</h3>
            <div class="app-screen-frame">
              <span class="phone-island" aria-hidden="true"></span>
              <img
                class="app-screen-shot screen-shot-image"
                data-screenshot={screen.id}
                alt={screen.title}
                loading="lazy"
                decoding="async"
                width="360"
                height="660"
              />
              <span class="phone-home" aria-hidden="true"></span>
            </div>
            <figcaption class="screen-caption">
              <p>{screen.body}</p>
            </figcaption>
          </figure>
        ))
      }
    </div>
  </div>
</section>

<section class="section section-alt">
  <div class="section-inner">
    <div class="section-heading" data-reveal>
      <h2>{t.home.audienceTitle}</h2>
      <p class="section-lead">{t.home.audienceSubtitle}</p>
    </div>
    <div class="audience-grid">
      {
        t.home.audience.map((item, index) => (
          <article class="card" data-reveal style={`--reveal-delay: ${index * 80}ms`}>
            <h3>{item.title}</h3>
            <p>{item.body}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<section class="section">
  <div class="section-inner">
    <div class="section-heading" data-reveal>
      <h2>{t.home.howTitle}</h2>
      <p class="section-lead">{t.home.howSubtitle}</p>
    </div>
    <div class="step-grid">
      {
        t.home.steps.map((step, index) => (
          <article class="card" data-reveal style={`--reveal-delay: ${index * 80}ms`}>
            <div class="step-index">{index + 1}</div>
            <h3>{step.title}</h3>
            <p>{step.body}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<section class="section section-alt">
  <div class="section-inner">
    <div class="section-heading" data-reveal>
      <h2>{t.home.faqTitle}</h2>
      <p class="section-lead">{t.home.faqSubtitle}</p>
    </div>
    <div class="faq-list" data-faq-accordion>
      {
        t.home.faq.map((item, index) => (
          <article class="faq-item" data-reveal style={`--reveal-delay: ${Math.min(index, 4) * 50}ms`}>
            <h3 class="faq-question">
              <button
                type="button"
                class="faq-trigger"
                aria-expanded="false"
                id={`faq-trigger-${index}`}
                aria-controls={`faq-panel-${index}`}
              >
                <span>{item.question}</span>
              </button>
            </h3>
            <div
              class="faq-panel"
              id={`faq-panel-${index}`}
              role="region"
              aria-labelledby={`faq-trigger-${index}`}
            >
              <div class="faq-panel-inner">
                <p>{item.answer}</p>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<section class="section">
  <div class="section-inner">
    <div class="cta-band" data-reveal>
      <div>
        <h2 aria-label={ctaPlayLetter && ctaPlayIndex >= 0 ? t.home.ctaTitle : undefined}>
          {
            ctaPlayLetter && ctaPlayIndex >= 0 && ctaWordStart >= 0 ? (
              <>{t.home.ctaTitle.slice(0, ctaWordStart)}<span class="cta-play-word">{t.home.ctaTitle.slice(ctaWordStart, ctaPlayIndex)}<span class="cta-play-letter">{ctaPlayLetter}</span>{t.home.ctaTitle.slice(ctaPlayIndex + ctaPlayLetter.length, ctaWordEnd)}</span>{t.home.ctaTitle.slice(ctaWordEnd)}</>
            ) : (
              t.home.ctaTitle
            )
          }
        </h2>
        <p class="section-lead">{t.home.ctaBody}</p>
      </div>
      <div class="hero-actions">
        <PlatformDownloads
          apkUrl={apkUrl}
          ipaUrl={ipaUrl}
          downloadAndroid={t.home.downloadAndroid}
          downloadIos={t.home.downloadIos}
          unavailableAndroid={t.home.downloadUnavailableAndroid}
          unavailableIos={t.home.downloadUnavailableIos}
        />
        <DemoButton label={t.home.openDemo} />
      </div>
    </div>
  </div>
</section>

<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

<script>
  import { mediaMaxWidthRem, parseCssLengthToPx, pxToRemCSSValue } from '../scripts/css-length';

  (function () {
    document.querySelectorAll('[data-hero-slider]').forEach(function (slider) {
      var viewport = slider.querySelector('.hero-slider-viewport');
      var track = slider.querySelector('.hero-slider-track');
      var prevBtn = slider.querySelector('[data-hero-slider-prev]');
      var nextBtn = slider.querySelector('[data-hero-slider-next]');
      if (!viewport || !track || !prevBtn || !nextBtn) return;

      var index = 0;
      var touchStartX = 0;
      var touchStartY = 0;
      var dragOffset = 0;
      var isDragging = false;
      var isHorizontalSwipe = false;
      var swipeThreshold = 48;
      var media = window.matchMedia(mediaMaxWidthRem(860));

      var copySlide = track.querySelector('.hero-copy');
      var resizeObserver = null;

      function syncViewportHeight() {
        if (!media.matches || !copySlide) {
          slider.style.removeProperty('--hero-slider-height');
          viewport.style.height = '';
          return;
        }

        var height = copySlide.offsetHeight;
        var shadowSpread = 0;
        if (media.matches) {
          var spreadValue = getComputedStyle(slider).getPropertyValue('--hero-phone-shadow-spread-y').trim();
          shadowSpread = spreadValue ? parseCssLengthToPx(spreadValue) : 48;
        }
        slider.style.setProperty('--hero-slider-height', pxToRemCSSValue(height));
        viewport.style.height = pxToRemCSSValue(height + shadowSpread);
      }

      function startHeightObserver() {
        if (!copySlide || resizeObserver) return;
        resizeObserver = new ResizeObserver(syncViewportHeight);
        resizeObserver.observe(copySlide);
      }

      function stopHeightObserver() {
        if (!resizeObserver) return;
        resizeObserver.disconnect();
        resizeObserver = null;
      }

      function getSlideWidth() {
        var slide = track.querySelector('.hero-slider-slide');
        return slide ? slide.offsetWidth : viewport.clientWidth;
      }

      function clampDragOffset(offset) {
        if (index === 0 && offset > 0) return offset * 0.28;
        if (index === 1 && offset < 0) return offset * 0.28;
        return offset;
      }

      function setTrackPosition(offsetPx, animate) {
        var slideWidth = getSlideWidth();
        if (!slideWidth) return;

        track.classList.toggle('is-dragging', !animate);
        track.style.transform =
          'translateX(' + pxToRemCSSValue(-index * slideWidth + offsetPx) + ')';
      }

      function updateSlider() {
        if (!media.matches) {
          index = 0;
          dragOffset = 0;
          isDragging = false;
          isHorizontalSwipe = false;
          track.classList.remove('is-dragging');
          track.style.transform = '';
          prevBtn.hidden = true;
          nextBtn.hidden = true;
          stopHeightObserver();
          syncViewportHeight();
          return;
        }

        startHeightObserver();
        syncViewportHeight();
        setTrackPosition(0, true);
        prevBtn.hidden = index === 0;
        nextBtn.hidden = index === 1;
      }

      function onTouchMove(event) {
        if (!media.matches || !isDragging || event.touches.length !== 1) return;

        var touch = event.touches[0];
        var deltaX = touch.clientX - touchStartX;
        var deltaY = touch.clientY - touchStartY;

        if (!isHorizontalSwipe) {
          if (Math.abs(deltaX) < 8 && Math.abs(deltaY) < 8) return;
          if (Math.abs(deltaY) > Math.abs(deltaX)) {
            isDragging = false;
            viewport.removeEventListener('touchmove', onTouchMove);
            return;
          }
          isHorizontalSwipe = true;
        }

        dragOffset = clampDragOffset(deltaX);
        setTrackPosition(dragOffset, false);
        event.preventDefault();
      }

      function endTouch(event) {
        viewport.removeEventListener('touchmove', onTouchMove);

        if (!media.matches || !isDragging) return;

        if (isHorizontalSwipe) {
          var touch = event.changedTouches[0];
          var deltaX = touch ? touch.clientX - touchStartX : dragOffset;
          var slideWidth = getSlideWidth();
          var shouldAdvance =
            Math.abs(deltaX) > swipeThreshold || Math.abs(dragOffset) > slideWidth * 0.18;

          if (deltaX < 0 && index < 1 && shouldAdvance) {
            index = 1;
          } else if (deltaX > 0 && index > 0 && shouldAdvance) {
            index = 0;
          }
        }

        isDragging = false;
        isHorizontalSwipe = false;
        dragOffset = 0;
        updateSlider();
      }

      prevBtn.addEventListener('click', function () {
        if (!media.matches || index === 0) return;
        index = 0;
        updateSlider();
      });

      nextBtn.addEventListener('click', function () {
        if (!media.matches || index === 1) return;
        index = 1;
        updateSlider();
      });

      viewport.addEventListener(
        'touchstart',
        function (event) {
          if (!media.matches || event.touches.length !== 1) return;
          touchStartX = event.touches[0].clientX;
          touchStartY = event.touches[0].clientY;
          dragOffset = 0;
          isDragging = true;
          isHorizontalSwipe = false;
          viewport.addEventListener('touchmove', onTouchMove, { passive: false });
        },
        { passive: true },
      );

      viewport.addEventListener('touchend', endTouch, { passive: true });
      viewport.addEventListener('touchcancel', endTouch, { passive: true });

      if (typeof media.addEventListener === 'function') {
        media.addEventListener('change', updateSlider);
      } else if (typeof media.addListener === 'function') {
        media.addListener(updateSlider);
      }

      window.addEventListener('resize', updateSlider);
      updateSlider();
    });

    document.querySelectorAll('[data-faq-accordion]').forEach(function (list) {
      var items = list.querySelectorAll('.faq-item');

      items.forEach(function (item) {
        var trigger = item.querySelector('.faq-trigger');
        if (!trigger) return;

        trigger.addEventListener('click', function () {
          var isOpen = item.classList.contains('is-open');

          items.forEach(function (other) {
            if (other === item) return;
            other.classList.remove('is-open');
            var otherTrigger = other.querySelector('.faq-trigger');
            if (otherTrigger) otherTrigger.setAttribute('aria-expanded', 'false');
          });

          if (isOpen) {
            item.classList.remove('is-open');
            trigger.setAttribute('aria-expanded', 'false');
            return;
          }

          item.classList.add('is-open');
          trigger.setAttribute('aria-expanded', 'true');
        });
      });
    });
  })();
</script>
