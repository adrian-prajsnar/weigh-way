---
import { getMessages, localePath, type SiteLocale } from '../i18n';
import { withBase } from '../lib/paths';
import BrandLogo from './brand-logo.astro';

type Props = { locale: SiteLocale };
const { locale } = Astro.props;
const t = getMessages(locale);
const year = new Date().getFullYear();
const contactEmail = 'adrian.prajsnar.dev@outlook.com';
---

<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-brand">
      <BrandLogo class="footer-logo" size={40} />
      <div>
        <p class="footer-brand-name">{t.brand}</p>
        <p class="footer-tagline">{t.footer.tagline}</p>
        <p class="footer-copy">© {year} {t.footer.copyrightName}</p>
      </div>
    </div>
    <div class="footer-meta">
      <nav class="footer-links" aria-label={t.footer.legalNav}>
        <a href={withBase(localePath(locale, 'privacy'))}>{t.footer.privacyPolicy}</a>
        <a href={withBase(localePath(locale, 'terms'))}>{t.footer.termsOfService}</a>
      </nav>
      <p class="footer-contact">
        <span class="footer-contact-prompt">{t.footer.questions}</span>
        <span class="footer-contact-separator" aria-hidden="true"></span>
        <a class="footer-contact-mail" href={`mailto:${contactEmail}`}>{contactEmail}</a>
      </p>
    </div>
  </div>
</footer>
