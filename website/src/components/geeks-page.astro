---
import DemoButton from './demo-button.astro';
import { getMessages, type SiteLocale } from '../i18n';
import { withBase } from '../lib/paths';

type Props = { locale: SiteLocale };
const { locale } = Astro.props;
const t = getMessages(locale);
const page = t.geeks;
const repoUrl = 'https://github.com/adrian-prajsnar/weigh-way';
const heroImageSrc = withBase('/images/geeks-hero.webp');
const rlsIcons = [
  '<circle cx="8" cy="15" r="4"/><path d="M11 13l8-8M16 5h3v3"/>',
  '<circle cx="12" cy="8" r="3"/><path d="M5 19c1.2-3.4 3.8-5 7-5s5.8 1.6 7 5"/>',
  '<path d="M5 7h14M9 7V5h6v2M8 7l1 13h6l1-13"/>',
];
const pipelineIcons = [
  '<circle cx="7" cy="7" r="2.2"/><circle cx="17" cy="17" r="2.2"/><path d="M9 8.2c2.4 1 3.6 2.6 4.8 5.6"/>',
  '<path d="M8 6.5h8l2 2.2V18H8z"/><path d="M16 6.5V9h2.2"/>',
  '<rect x="7" y="4.5" width="10" height="15" rx="2"/><path d="M11 17.2h2"/>',
  '<rect x="6" y="5" width="12" height="14" rx="2"/><path d="M9 8.5h6M9 11.5h4"/>',
  '<circle cx="12" cy="12" r="7"/><path d="M5.5 12h13M12 5.2c2 2.1 3 4.3 3 6.8s-1 4.7-3 6.8c-2-2.1-3-4.3-3-6.8s1-4.7 3-6.8"/>',
];
---

<section class="geeks-hero" aria-labelledby="geeks-hero-title">
  <div class="geeks-hero__media">
    <img
      src={heroImageSrc}
      alt={page.heroImageAlt}
      width="1800"
      height="1200"
      loading="eager"
      decoding="async"
      fetchpriority="high"
    />
  </div>
  <div class="section-inner geeks-hero__inner">
    <div class="geeks-hero__copy is-visible" data-reveal>
      <p class="eyebrow">{page.eyebrow}</p>
      <h1 id="geeks-hero-title"><span class="headline-accent">{page.title}</span></h1>
      <p class="geeks-hero__lead">{page.lead}</p>
      <div class="hero-actions">
        <DemoButton label={page.demoLink} />
      </div>
    </div>
  </div>
</section>

<section class="section" aria-labelledby="geeks-architecture">
  <div class="section-inner">
    <div class="section-heading" data-reveal>
      <h2 id="geeks-architecture">{page.architectureTitle}</h2>
      <p class="section-lead">{page.architectureLead}</p>
    </div>
    <ol class="eng-flow">
      {
        page.nodes.map((node, index) => (
          <li class="eng-node" data-reveal style={`--reveal-delay: ${index * 80}ms`}>
            <span class="eng-index" aria-hidden="true">
              {index + 1}
            </span>
            <h3>{node.title}</h3>
            <p>{node.body}</p>
          </li>
        ))
      }
    </ol>
    <div class="eng-tables" data-reveal>
      <h3 class="eng-kicker">{page.tablesTitle}</h3>
      <ul class="eng-table-list">
        {
          page.tables.map((table) => (
            <li class="card">
              <p class="eng-table-name">{table.name}</p>
              <p>{table.body}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<section class="section section-alt" aria-labelledby="geeks-rls">
  <div class="section-inner">
    <div class="section-heading" data-reveal>
      <h2 id="geeks-rls">{page.rlsTitle}</h2>
      <p class="section-lead">{page.rlsLead}</p>
    </div>
    <div class="highlight-grid">
      {
        page.rlsPoints.map((point, index) => (
          <article class="card eng-rls-card" data-reveal style={`--reveal-delay: ${index * 80}ms`}>
            <span class="eng-rls__icon" aria-hidden="true">
              <svg
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <Fragment set:html={rlsIcons[index]} />
              </svg>
            </span>
            <h3>{point.title}</h3>
            <p>{point.body}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<section class="section" aria-labelledby="geeks-decisions">
  <div class="section-inner">
    <div class="section-heading" data-reveal>
      <h2 id="geeks-decisions">{page.decisionsTitle}</h2>
      <p class="section-lead">{page.decisionsLead}</p>
    </div>
    <div class="feature-grid">
      {
        page.decisions.map((item, index) => (
          <article class="card" data-reveal style={`--reveal-delay: ${(index % 2) * 80}ms`}>
            <h3>{item.title}</h3>
            <p>{item.body}</p>
            <p class="eng-tradeoff">
              <span class="eng-tradeoff-label">{page.tradeoffLabel}</span>
              {item.tradeoff}
            </p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<section class="section section-alt" aria-labelledby="geeks-shipping">
  <div class="section-inner shipping-layout">
    <div class="shipping-copy">
      <div class="section-heading" data-reveal>
        <h2 id="geeks-shipping">{page.shippingTitle}</h2>
        <p class="section-lead">{page.shippingLead}</p>
      </div>
      <ol class="eng-pipeline">
        {
          page.shipping.map((step, index) => (
            <li data-reveal style={`--reveal-delay: ${index * 60}ms`}>
              <span class="eng-index" aria-hidden="true">
                {index + 1}
              </span>
              <div>
                <h3>{step.title}</h3>
                <p>{step.body}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
    <figure class="pipeline-art" data-reveal style="--reveal-delay: 80ms" aria-hidden="true">
      <ol class="pipeline-art__flow">
        {
          page.pipelineArt.map((step, index) => (
            <li class:list={['pipeline-art__step', { 'is-last': index === page.pipelineArt.length - 1 }]}>
              <span class="pipeline-art__node">
                <svg
                  width="18"
                  height="18"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <Fragment set:html={pipelineIcons[index]} />
                </svg>
              </span>
              <span class="pipeline-art__card">
                <span class="pipeline-art__title">{step.title}</span>
                <span class="pipeline-art__detail">{step.detail}</span>
              </span>
            </li>
          ))
        }
      </ol>
    </figure>
  </div>
</section>

<section class="section" aria-labelledby="geeks-limits">
  <div class="section-inner">
    <div class="section-heading" data-reveal>
      <h2 id="geeks-limits">{page.limitsTitle}</h2>
      <p class="section-lead">{page.limitsLead}</p>
    </div>
    <div class="highlight-grid">
      {
        page.limits.map((item, index) => (
          <article class="card" data-reveal style={`--reveal-delay: ${index * 80}ms`}>
            <h3>{item.title}</h3>
            <p>{item.body}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<section class="section">
  <div class="section-inner">
    <div class="cta-band" data-reveal>
      <div>
        <h2>{page.repoTitle}</h2>
        <p class="section-lead">{page.repoBody}</p>
      </div>
      <a class="btn btn-primary" href={repoUrl} rel="noopener noreferrer">
        <span>{page.repoLink}</span>
      </a>
    </div>
  </div>
</section>
