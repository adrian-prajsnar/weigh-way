---
import '../styles/global.css';
import DemoModal from '../components/demo-modal.astro';
import { getMessages, localePath, type SiteLocale, type SitePage } from '../i18n';
import { withBase, absoluteUrl } from '../lib/paths';
import { buildDownloadPlatformBootstrapScript } from '../lib/download-platform';
import { buildThemeBootstrapScript } from '../lib/site-preferences';
import { buildScreenshotBootstrapScript } from '../lib/screenshot-sync';

type Props = {
  locale: SiteLocale;
  page: SitePage;
  title: string;
  description: string;
};

const { locale, page, title, description } = Astro.props;
const t = getMessages(locale);
const canonical = absoluteUrl(localePath(locale, page));
const enUrl = absoluteUrl(localePath('en', page));
const plUrl = absoluteUrl(localePath('pl', page));
const ogLocales: Record<SiteLocale, string> = { en: 'en_US', pl: 'pl_PL' };
const ogAlternateLocale = ogLocales[locale === 'en' ? 'pl' : 'en'];
const shareImage = absoluteUrl(`/og-image-${locale}.png`);
const fontStylesheet =
  'https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap';
---

<!doctype html>
<html lang={locale} data-screenshot-locale={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="pl" href={plUrl} />
    <link rel="alternate" hreflang="x-default" href={enUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={t.brand} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ogLocales[locale]} />
    <meta property="og:locale:alternate" content={ogAlternateLocale} />
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t.meta.shareImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={shareImage} />
    <meta name="twitter:image:alt" content={t.meta.shareImageAlt} />
    <link rel="icon" href={withBase('/favicon.png')} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href={fontStylesheet} rel="stylesheet" media="print" onload="this.media='all'" />
    <noscript><link href={fontStylesheet} rel="stylesheet" /></noscript>
    <script is:inline set:html={buildThemeBootstrapScript()} />
    <script is:inline set:html={buildScreenshotBootstrapScript(import.meta.env.BASE_URL)} />
    <script is:inline set:html={buildDownloadPlatformBootstrapScript()} />
  </head>
  <body>
    <a class="skip-link" href="#content">{t.nav.skipToContent}</a>
    <div class="page-fx" aria-hidden="true">
      <div class="page-fx-grid"></div>
    </div>
    <div class="scroll-progress" hidden></div>
    <slot />
    <DemoModal locale={locale} />
    <script>
      import { pxToRemCSSValue } from '../scripts/css-length';

      (function () {
        var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        var header = document.querySelector<HTMLElement>('.site-header');
        var progress = document.querySelector('.scroll-progress');

        if (header) {
          const syncHeaderHeight = () => {
            document.documentElement.style.setProperty(
              '--measured-header-height',
              `${header.getBoundingClientRect().height}px`,
            );
          };
          new ResizeObserver(syncHeaderHeight).observe(header, { box: 'border-box' });
          syncHeaderHeight();
        }

        var scrollTicking = false;

        function updateScrollChrome() {
          var scrolled = window.scrollY > 8;
          if (header) header.classList.toggle('is-scrolled', scrolled);
          if (!progress) return;
          var doc = document.documentElement;
          var max = doc.scrollHeight - window.innerHeight;
          var ratio = max > 0 ? Math.min(1, window.scrollY / max) : 0;
          progress.style.transform = 'scaleX(' + ratio + ')';
          progress.hidden = false;
        }

        function onScrollOrResize() {
          if (scrollTicking) return;
          scrollTicking = true;
          window.requestAnimationFrame(function () {
            updateScrollChrome();
            scrollTicking = false;
          });
        }

        updateScrollChrome();
        window.addEventListener('scroll', onScrollOrResize, { passive: true });
        window.addEventListener('resize', onScrollOrResize);

        if (!reduceMotion && 'IntersectionObserver' in window) {
          var reveal = new IntersectionObserver(
            function (entries) {
              entries.forEach(function (entry) {
                if (!entry.isIntersecting) return;
                entry.target.classList.add('is-visible');
                reveal.unobserve(entry.target);
              });
            },
            // IntersectionObserver requires px/% margins; unitless 0 is invalid.
            { threshold: 0.16, rootMargin: '0px 0px -8% 0px' },
          );
          document.querySelectorAll('[data-reveal]').forEach(function (el) {
            reveal.observe(el);
          });
        } else {
          document.querySelectorAll('[data-reveal]').forEach(function (el) {
            el.classList.add('is-visible');
          });
        }

        var finePointer = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
        if (finePointer) {
          document.querySelectorAll('.card, .release-card, .faq-item, .cta-band, .legal-document').forEach(function (card) {
            card.addEventListener('pointermove', function (event) {
              var rect = card.getBoundingClientRect();
              card.style.setProperty('--spot-x', pxToRemCSSValue(event.clientX - rect.left));
              card.style.setProperty('--spot-y', pxToRemCSSValue(event.clientY - rect.top));
            });
          });
        }

        function normalizePathname(pathname) {
          var path = pathname || '/';
          if (path.length > 1 && path.charAt(path.length - 1) === '/') {
            path = path.slice(0, -1);
          }
          return path || '/';
        }

        function isSamePageLink(link) {
          var href = link.getAttribute('href');
          if (!href || href.charAt(0) === '#') return false;
          try {
            var target = new URL(href, location.href);
            if (target.origin !== location.origin) return false;
            return normalizePathname(target.pathname) === normalizePathname(location.pathname) &&
              target.search === location.search;
          } catch (error) {
            return false;
          }
        }

        document.addEventListener('click', function (event) {
          var link = event.target.closest('a[href]');
          if (!link) return;
          if (
            event.defaultPrevented ||
            event.button !== 0 ||
            event.metaKey ||
            event.ctrlKey ||
            event.shiftKey ||
            event.altKey
          ) {
            return;
          }
          if (link.hash || (link.target && link.target !== '_self')) return;
          if (!isSamePageLink(link)) return;
          event.preventDefault();
          if (location.hash) history.pushState(null, '', link.href);
          document.getElementById('content')?.focus({ preventScroll: true });
          window.scrollTo({ top: 0, behavior: 'instant' });
        });

        if (reduceMotion) return;

        document.querySelectorAll('[data-hero-tilt]').forEach(function (frame) {
          var resetTimer;

          function setTilt(x, y) {
            frame.style.setProperty('--tilt-x', x.toFixed(2) + 'deg');
            frame.style.setProperty('--tilt-y', y.toFixed(2) + 'deg');
          }

          frame.addEventListener('pointermove', function (event) {
            var rect = frame.getBoundingClientRect();
            var x = ((event.clientX - rect.left) / rect.width - 0.5) * 10;
            var y = ((event.clientY - rect.top) / rect.height - 0.5) * -10;
            setTilt(x, y);
          });

          frame.addEventListener('pointerleave', function () {
            window.clearTimeout(resetTimer);
            resetTimer = window.setTimeout(function () {
              setTilt(0, 0);
            }, 80);
          });
        });
      })();
    </script>
  </body>
</html>
