# Local Supabase CLI (Docker). Run: npx supabase start
# Production URL and anon key live in EAS production env — never copy prod keys here.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54341
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0

# Optional. Local dev only: show the “update available” dialog without GitHub or real downloads.
# EXPO_PUBLIC_APP_UPDATE_MOCK=true
# EXPO_PUBLIC_APP_UPDATE_MOCK_LATEST=99.0.0

# Optional. Set this in EAS production so a released APK/IPA reports crashes.
# Reports include the app version and an error code. They do not include weigh-ins.
# EXPO_PUBLIC_SENTRY_DSN=
# Native build source maps (optional; EAS production). All three are required to upload.
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_DISABLE_AUTO_UPLOAD=true

# Release notes (local: node scripts/snapshot-release-notes.cjs <version> --force)
# GEMINI_API_KEY=your-google-ai-studio-key
# GEMINI_MODEL=gemini-3.8-flash
