# Same Supabase project for local dev and production APK.
# Use a separate dev test account in the app (see README → Safe dev on production).
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Dev auth guard (+dev emails). On by default in local dev; set false to sign in with any email.
EXPO_PUBLIC_DEV=true
